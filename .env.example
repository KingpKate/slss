# SLSS V2.0 environment template
# Copy this file to .env or .env.local and replace the placeholder values.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=slss_user
DB_PASSWORD=change_me
DB_NAME=slss_db

# Express server
# In development, Vite proxies /api to this port.
PORT=3001

# JWT authentication
# Leave JWT_SECRET empty to disable API token enforcement.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Business rules
DEFECT_RATE_LOCK_THRESHOLD=3
QUOTATION_VALIDITY_HOURS=72

# AI integration used by services/geminiService.ts
API_KEY=
